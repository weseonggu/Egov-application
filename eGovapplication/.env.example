# ============================================
# 민감 정보 설정 파일 예시
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요
# ============================================

# Oracle Database
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Application Ports
APP_PORT=8080
SWAGGER_PORT=8081
